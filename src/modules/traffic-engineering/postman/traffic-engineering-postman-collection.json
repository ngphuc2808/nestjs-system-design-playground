  "item": [
    {
      "name": "1. Configure Feature Flag (Set Rollout to 50%)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flagName\": \"NEW_CHECKOUT_V2\",\n  \"enabled\": true,\n  \"rolloutPercentage\": 50\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/v1/traffic-engineering/flags/toggle",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "v1", "traffic-engineering", "flags", "toggle"]
        }
      },
      "response": []
    },
